diff --git a/src/ggml-metal/ggml-metal.metal b/src/ggml-metal/ggml-metal.metal
index 25e78e10..ad9f24eb 100644
--- a/src/ggml-metal/ggml-metal.metal
+++ b/src/ggml-metal/ggml-metal.metal
@@ -4738,6 +4738,49 @@ kernel void kernel_im2col(
 template [[host_name("kernel_im2col_f32")]] kernel im2col_t kernel_im2col<float>;
 template [[host_name("kernel_im2col_f16")]] kernel im2col_t kernel_im2col<half>;
 
+// One thread per output element, in output order: consecutive threads write consecutive
+// addresses. kernel_im2col above runs one threadgroup of KH*KW*N threads per (channel, pixel),
+// i.e. a single thread per group for a 1x1 kernel, which leaves most of a GPU idle.
+template <typename T>
+kernel void kernel_im2col_flat(
+        constant ggml_metal_kargs_im2col_flat & args,
+        device const float * x,
+        device        char * dst,
+        uint tid[[thread_position_in_grid]]) {
+    if (tid >= args.total) {
+        return;
+    }
+
+    const uint chw = tid % (uint) args.CHW;
+    uint       pix = tid / (uint) args.CHW;
+    const int  iow = pix % (uint) args.OW; pix /= (uint) args.OW;
+    const int  ioh = pix % (uint) args.OH;
+    const uint in  = pix / (uint) args.OH;
+
+    const uint iic = chw / (uint) args.KHW;
+    const uint ik  = chw % (uint) args.KHW;
+    const int  ikh = ik / (uint) args.KW;
+    const int  ikw = ik % (uint) args.KW;
+
+    const int iiw = iow*args.s0 + ikw*args.d0 - args.p0;
+    const int iih = ioh*args.s1 + ikh*args.d1 - args.p1;
+
+    float v = 0.0f;
+    if (iih >= 0 && iih < args.IH && iiw >= 0 && iiw < args.IW) {
+        v = x[in*args.ofs0 + iic*args.ofs1 + (uint64_t) iih*args.IW + iiw];
+    }
+    ((device T *) dst)[tid] = (T) v;
+}
+
+typedef void (im2col_flat_t)(
+        constant ggml_metal_kargs_im2col_flat & args,
+        device const float * x,
+        device        char * dst,
+        uint tid[[thread_position_in_grid]]);
+
+template [[host_name("kernel_im2col_flat_f32")]] kernel im2col_flat_t kernel_im2col_flat<float>;
+template [[host_name("kernel_im2col_flat_f16")]] kernel im2col_flat_t kernel_im2col_flat<half>;
+
